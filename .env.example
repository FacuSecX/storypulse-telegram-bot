# Token creado con @BotFather. Nunca publiques el valor real.
BOT_TOKEN=REEMPLAZA_CON_TU_TOKEN

# IDs numéricos de Telegram autorizados, separados por comas.
TELEGRAM_USER_IDS=123456789

# Zona horaria usada para mostrar y programar revisiones.
TIMEZONE=America/Argentina/Buenos_Aires

# Archivo privado con los perfiles de Instagram.
ACCOUNTS_FILE=accounts.json

# Ruta de SQLite. El directorio se crea automáticamente.
DATABASE_PATH=data/storypulse.db

# false = Chromium oculto; true = ventana visible para depuración local.
SHOW_BROWSER=false
